{
  "manifest_version": 3,
  "name": "HouseHunting importer",
  "version": "1.0.0",
  "description": "Import rental listings from pages you are already viewing into your HouseHunting board.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.nobroker.in/*",
    "*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.nobroker.in/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "sites/nobroker.js",
        "sites/facebook.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
