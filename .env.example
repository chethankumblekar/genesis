# Host port for the web app. The container always listens on 43123.
APP_PORT=43123

# Postgres (used by Compose). For `npm run dev`, also set DATABASE_URL below.
POSTGRES_USER=househunting
POSTGRES_PASSWORD=househunting
POSTGRES_DB=househunting
DB_PORT=5432

# Local Node.js only (`npm run dev` / `npm start`). Compose sets this itself
# using the `db` hostname, so this localhost URL is not used inside Docker.
DATABASE_URL=postgres://househunting:househunting@127.0.0.1:5432/househunting
